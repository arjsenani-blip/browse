+      html {
+        --md-background-color: #f4f4f5 !important;
+        --color-webui-page-background: #f4f4f5 !important;
+        --color-settings-webui-page-background: #f4f4f5 !important;
+        --cr-card-background-color: #ffffff !important;
+        --color-webui-card-background: #ffffff !important;
+        --cr-card-border-radius: 14px !important;
+        --cr-card-shadow: 0 1px 2px rgba(0, 0, 0, .04),
+            0 6px 20px rgba(0, 0, 0, .04) !important;
+        --cr-separator-color: rgba(0, 0, 0, .05) !important;
+        --cr-primary-text-color: #18181b !important;
+        --cr-secondary-text-color: #71717a !important;
+        --cr-link-color: #3b82f6 !important;
+        --cr-checked-color: #3b82f6 !important;
+        --color-settings-nav-menu-item-background: #ffffff !important;
+        --color-settings-nav-menu-item-foreground: #52525b !important;
+        --color-settings-nav-menu-item-foreground-selected: #18181b !important;
+        --color-settings-nav-menu-item-icon: #a1a1aa !important;
+      }
+      html,
+      html[webui-refresh-2026],
+      html[settings-refresh-2026] {
