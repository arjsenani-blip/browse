+// Round white "+" with a ring that fills while swiping past the last space.
+class BrowsePlusRingView : public views::View {
+  METADATA_HEADER(BrowsePlusRingView, views::View)
+
+ public:
+  static constexpr int kSize = 40;
+
+  BrowsePlusRingView() {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetOpacity(0.f);
+    SetProperty(views::kViewIgnoredByLayoutKey, true);
+    SetCanProcessEventsWithinSubtree(false);
+    GetViewAccessibility().SetIsIgnored(true);
+  }
+
+  void SetState(float progress, SkColor start, SkColor end) {
+    progress_ = std::clamp(progress, 0.f, 1.f);
+    start_ = start;
+    end_ = end;
+    layer()->SetOpacity(std::min(1.f, progress_ * 2.5f));
+    gfx::Transform scale;
+    const float s = 0.8f + 0.2f * std::min(1.f, progress_ * 1.5f);
+    scale.Translate(kSize / 2.f, kSize / 2.f);
+    scale.Scale(s, s);
+    scale.Translate(-kSize / 2.f, -kSize / 2.f);
+    layer()->SetTransform(scale);
+    SchedulePaint();
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::PointF c(kSize / 2.f, kSize / 2.f);
+    constexpr float kRadius = 14.f;
+    cc::PaintFlags shadow;
+    shadow.setAntiAlias(true);
+    shadow.setColor(SkColorSetA(SK_ColorBLACK, 0x30));
+    shadow.setImageFilter(sk_make_sp<cc::BlurPaintFilter>(
+        3.f, 3.f, SkTileMode::kDecal, nullptr));
+    canvas->DrawCircle(gfx::PointF(c.x(), c.y() + 1.5f), kRadius, shadow);
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(progress_ >= 1.f ? end_ : SK_ColorWHITE);
+    canvas->DrawCircle(c, kRadius, fill);
+
+    // Ring: fills clockwise from the top as the swipe goes on.
+    const SkPoint points[2] = {SkPoint::Make(0, 0), SkPoint::Make(kSize, kSize)};
+    const SkColor4f colors[2] = {SkColor4f::FromColor(start_),
+                                 SkColor4f::FromColor(end_)};
+    cc::PaintFlags ring;
+    ring.setAntiAlias(true);
+    ring.setStyle(cc::PaintFlags::kStroke_Style);
+    ring.setStrokeWidth(2.5f);
+    ring.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    ring.setShader(cc::PaintShader::MakeLinearGradient(
+        points, colors, nullptr, 2, SkTileMode::kClamp));
+    SkPathBuilder arc_builder;
+    arc_builder.addArc(SkRect::MakeXYWH(c.x() - kRadius, c.y() - kRadius, 2 * kRadius,
+                                2 * kRadius),
+               -90.f, 360.f * progress_);
+    canvas->DrawPath(arc_builder.detach(), ring);
+
+    constexpr int kPlus = 16;
+    canvas->DrawImageInt(
+        gfx::CreateVectorIcon(kAddIcon, kPlus,
+                              progress_ >= 1.f ? SK_ColorWHITE : end_),
+        (kSize - kPlus) / 2, (kSize - kPlus) / 2);
+  }
+
+ private:
+  float progress_ = 0.f;
+  SkColor start_ = SK_ColorBLUE;
+  SkColor end_ = SK_ColorBLUE;
+};
