+void BrowseSpaceIndicatorView::NewFolder() {
+  // Folders are named tab groups: they're kept with the session and never
+  // touched by the automatic site grouping. Start one with the current tab.
+  TabStripModel* model = browser_view_->browser()->GetTabStripModel();
+  const int index = model->active_index();
+  if (index < 0 || model->IsTabPinned(index)) {
+    return;
+  }
+  if (model->GetTabGroupForTab(index)) {
+    model->RemoveFromGroup({index});
   }
+  const tab_groups::TabGroupId group = model->AddToNewGroup({index});
+  model->ChangeTabGroupVisuals(
+      group, tab_groups::TabGroupVisualData(
+                 u"New folder", tab_groups::TabGroupColorId::kGrey, false));
 }
 
