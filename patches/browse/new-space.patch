+namespace browse_new_space {
+namespace {
+
+// Floating card (top tab bar mode).
+constexpr int kCardWidth = 360;
+constexpr int kCardHeight = 420;
+constexpr int kCardRadius = 16;
+constexpr int kBadgeSize = 44;
+constexpr int kFieldHeight = 40;
+constexpr int kIconCell = 28;
+constexpr int kIconsPerRow = 5;
+constexpr int kColorDot = 20;
+constexpr int kButtonHeight = 36;
+
+// Vertical positions, from the top of the card / panel.
+struct Geometry {
+  int pad = 24;
+  int badge_top = 28;
+  int title_top = 84;
+  int subtitle_top = 112;
+  int field_top = 160;
+  int icon_label_top = 216;
+  int icon_row_top = 236;
+  int color_label_top = 310;
+  int color_row_top = 330;
+  int button_top = 0;  // Set from the height.
+  int cancel_top = 0;
+};
+
+Geometry GeometryFor(bool panel, int height) {
+  Geometry g;
+  if (panel) {
+    // Arc-style: the sidebar itself becomes the panel.
+    g.pad = 14;
+    g.badge_top = 56;
+    g.title_top = 112;
+    g.subtitle_top = 140;
+    g.field_top = 190;
+    g.icon_label_top = 246;
+    g.icon_row_top = 266;
+    g.color_label_top = 340;
+    g.color_row_top = 360;
+    g.button_top = std::max(g.color_row_top + 44, height - 110);
+    g.cancel_top = g.button_top + kButtonHeight + 8;
+  } else {
+    g.button_top = height - 76;
+    g.cancel_top = g.button_top + kButtonHeight + 4;
+  }
+  return g;
+}
+
+const SkColor kCardColor = SK_ColorWHITE;
+const SkColor kTextColor = SkColorSetRGB(0x18, 0x18, 0x1B);
+const SkColor kSubtleText = SkColorSetRGB(0x71, 0x71, 0x7A);
+const SkColor kFieldFill = SkColorSetARGB(0x0B, 0, 0, 0);
+const SkColor kSelectedFill = SkColorSetARGB(0x12, 0, 0, 0);
+
+const gfx::FontList& TitleFont() {
+  static const base::NoDestructor<gfx::FontList> font(
+      gfx::FontList().DeriveWithSizeDelta(4).DeriveWithWeight(
+          gfx::Font::Weight::SEMIBOLD));
+  return *font;
+}
+
+const gfx::FontList& SubtitleFont() {
+  static const base::NoDestructor<gfx::FontList> font(
+      gfx::FontList().DeriveWithSizeDelta(-1));
+  return *font;
+}
+
+const gfx::FontList& LabelFont() {
+  static const base::NoDestructor<gfx::FontList> font(
+      gfx::FontList().DeriveWithSizeDelta(-1).DeriveWithWeight(
+          gfx::Font::Weight::MEDIUM));
+  return *font;
+}
+
+const gfx::FontList& ButtonFont() {
+  static const base::NoDestructor<gfx::FontList> font(
+      gfx::FontList().DeriveWithWeight(gfx::Font::Weight::MEDIUM));
+  return *font;
+}
+
+cc::PaintFlags GradientFlags(const gfx::RectF& r, int slot, bool diagonal) {
+  const SkPoint points[2] = {
+      SkPoint::Make(r.x(), r.y()),
+      diagonal ? SkPoint::Make(r.right(), r.bottom())
+               : SkPoint::Make(r.right(), r.y())};
+  const SkColor4f colors[2] = {
+      SkColor4f::FromColor(browse_spaces::ColorForIndex(slot)),
+      SkColor4f::FromColor(browse_spaces::GradientEndForIndex(slot))};
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setShader(cc::PaintShader::MakeLinearGradient(points, colors, nullptr,
+                                                      2, SkTileMode::kClamp));
+  return flags;
+}
+
+class SheetView;
+
+// The white card: paints the badge, labels, pickers and buttons around the
+// name field, and handles clicks on them.
+class SheetCard : public views::View {
+  METADATA_HEADER(SheetCard, views::View)
+
+ public:
+  SheetCard(SheetView* owner, bool panel) : owner_(owner), panel_(panel) {}
+
+  Geometry geo() const { return GeometryFor(panel_, height()); }
+  int inner_width() const { return width() - 2 * geo().pad; }
+
+  // Icons in two rows of five, spread across the width.
+  gfx::Rect IconCell(int i) const {
+    const Geometry g = geo();
+    const int gap = (inner_width() - kIconsPerRow * kIconCell) /
+                    (kIconsPerRow - 1);
+    return gfx::Rect(g.pad + (i % kIconsPerRow) * (kIconCell + gap),
+                     g.icon_row_top + (i / kIconsPerRow) * (kIconCell + 6),
+                     kIconCell, kIconCell);
+  }
+  gfx::Rect ColorDot(int i) const {
+    const Geometry g = geo();
+    const int count = browse_spaces::GradientCount();
+    const int gap = (inner_width() - 4 - count * kColorDot) / (count - 1);
+    return gfx::Rect(g.pad + 2 + i * (kColorDot + gap), g.color_row_top,
+                     kColorDot, kColorDot);
+  }
+  gfx::Rect CreateButton() const {
+    const Geometry g = geo();
+    return gfx::Rect(g.pad, g.button_top, inner_width(), kButtonHeight);
+  }
+  gfx::Rect CancelButton() const {
+    const Geometry g = geo();
+    return gfx::Rect(g.pad, g.cancel_top, inner_width(), 28);
+  }
+  gfx::Rect FieldRect() const {
+    const Geometry g = geo();
+    return gfx::Rect(g.pad, g.field_top, inner_width(), kFieldHeight);
+  }
+  bool panel() const { return panel_; }
+
+  void OnPaint(gfx::Canvas* canvas) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+
+ private:
+  raw_ptr<SheetView> owner_;
+  bool panel_;
+};
+
+BEGIN_METADATA(SheetCard)
+END_METADATA
+
+class SheetView : public views::View, public views::TextfieldController {
+  METADATA_HEADER(SheetView, views::View)
+
+ public:
+  SheetView(BrowserView* browser_view,
+            bool panel,
+            base::OnceClosure close_callback)
+      : browser_view_(browser_view),
+        panel_(panel),
+        close_callback_(std::move(close_callback)) {
+    spaces_ = browse_spaces::GetSpaces();
+    const int count = static_cast<int>(spaces_.size());
+    // Default to the next color in the palette that no space uses yet.
+    gradient_ = count % browse_spaces::GradientCount();
+    for (int g = 0; g < browse_spaces::GradientCount(); ++g) {
+      bool used = false;
+      for (int i = 0; i < count; ++i) {
+        used |= browse_spaces::GradientFor(spaces_, i) %
+                    browse_spaces::GradientCount() ==
+                g;
+      }
+      if (!used) {
+        gradient_ = g;
+        break;
+      }
+    }
+
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+
+    card_ = AddChildView(std::make_unique<SheetCard>(this, panel_));
+    card_->SetPaintToLayer();
+    card_->layer()->SetFillsBoundsOpaquely(false);
+    if (!panel_) {
+      card_->layer()->SetRoundedCornerRadius(
+          gfx::RoundedCornersF(kCardRadius));
+    }
+
+    field_ = card_->AddChildView(std::make_unique<views::Textfield>());
+    field_->set_controller(this);
+    field_->SetBorder(nullptr);
+    field_->SetBackground(nullptr);
+    field_->SetColor(kTextColor);
+    field_->SetFontList(gfx::FontList().DeriveWithSizeDelta(1));
+    field_->SetPlaceholderText(DefaultName());
+    field_->GetViewAccessibility().SetName(u"Space name");
+  }
+
+  int icon() const { return icon_; }
+  int gradient() const { return gradient_; }
+  void set_icon(int icon) {
+    icon_ = icon;
+    card_->SchedulePaint();
+  }
+  void set_gradient(int gradient) {
+    gradient_ = gradient;
+    SchedulePaint();
+    card_->SchedulePaint();
+  }
+
+  std::u16string DefaultName() const {
+    return u"Space " + base::NumberToString16(spaces_.size() + 1);
+  }
+  std::u16string Name() const {
+    std::u16string name;
+    base::TrimWhitespace(std::u16string(field_->GetText()), base::TRIM_ALL,
+                         &name);
+    return name.empty() ? DefaultName() : name;
+  }
+
+  // The icon shown in the badge: the chosen one, or what the name suggests.
+  const gfx::VectorIcon& PreviewIcon() const {
+    browse_spaces::Space preview{base::FilePath(), Name(), icon_, -1};
+    return browse_spaces::IconForSpace(preview,
+                                       static_cast<int>(spaces_.size()));
+  }
+  // Icon choice that the automatic pick corresponds to, for highlighting.
+  int EffectiveIcon() const {
+    if (icon_ >= 0) {
+      return icon_;
+    }
+    const gfx::VectorIcon& auto_icon = PreviewIcon();
+    for (int i = 0; i < browse_spaces::SpaceIconChoiceCount(); ++i) {
+      if (&browse_spaces::SpaceIconChoice(i) == &auto_icon) {
+        return i;
+      }
+    }
+    return -1;
+  }
+
+  void FocusField() { field_->RequestFocus(); }
+
+  void AnimateIn() {
+    layer()->SetOpacity(0.f);
+    gfx::Transform start;
+    if (panel_) {
+      start.Translate(-24.f, 0);  // Slides in from the left, like Arc.
+    } else {
+      start.Translate(0, 10.f);
+      start.Scale(0.96f, 0.96f);
+    }
+    card_->layer()->SetTransform(start);
+    {
+      ui::ScopedLayerAnimationSettings settings(layer()->GetAnimator());
+      settings.SetTransitionDuration(base::Milliseconds(160));
+      settings.SetTweenType(gfx::Tween::EASE_OUT);
+      layer()->SetOpacity(1.f);
+    }
+    ui::ScopedLayerAnimationSettings settings(card_->layer()->GetAnimator());
+    settings.SetTransitionDuration(base::Milliseconds(240));
+    settings.SetTweenType(gfx::Tween::EASE_OUT_3);
+    card_->layer()->SetTransform(gfx::Transform());
+  }
+
+  void Create() {
+    if (created_) {
+      return;
+    }
+    created_ = true;
+    bool keep_frame = false;
+    gfx::Rect frame;
+    if (views::Widget* widget = browser_view_->GetWidget()) {
+      keep_frame = !widget->IsFullscreen() && !widget->IsMinimized();
+      frame = widget->GetWindowBoundsInScreen();
+    }
+    ProfileManager::CreateMultiProfileAsync(
+        Name(), profiles::GetPlaceholderAvatarIndex(), /*is_hidden=*/false,
+        base::BindOnce(
+            [](int icon, int gradient, bool keep_frame, gfx::Rect frame,
+               Profile* profile) {
+              if (!profile) {
+                return;
+              }
+              browse_spaces::SetSpaceStyle(profile->GetPath(), icon, gradient);
+              browse_spaces::OpenSpaceInFrame(profile->GetPath(), keep_frame,
+                                              frame);
+            },
+            icon_, gradient_, keep_frame, frame));
+    Close();
+  }
+
+  void Close() {
+    if (close_callback_) {
+      std::move(close_callback_).Run();
+    }
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    if (panel_) {
+      card_->SetBoundsRect(GetLocalBounds());
+    } else {
+      const int w = std::min(kCardWidth, width() - 32);
+      card_->SetBounds((width() - w) / 2,
+                       std::max(16, (height() - kCardHeight) * 2 / 5), w,
+                       kCardHeight);
+    }
+    // Room on the left of the field for the chosen icon.
+    const gfx::Rect field = card_->FieldRect();
+    field_->SetBounds(field.x() + 38, field.y(), field.width() - 48,
+                      field.height());
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (panel_) {
+      return;  // The card covers the whole sidebar.
+    }
+    const gfx::RectF bounds(GetLocalBounds());
+    // Wash in the chosen gradient, so the page previews the space's color.
+    cc::PaintFlags wash;
+    const SkPoint points[2] = {SkPoint::Make(0, 0),
+                               SkPoint::Make(bounds.width(), bounds.height())};
+    const SkColor4f colors[2] = {
+        SkColor4f::FromColor(
+            SkColorSetA(browse_spaces::ColorForIndex(gradient_), 0x48)),
+        SkColor4f::FromColor(
+            SkColorSetA(browse_spaces::GradientEndForIndex(gradient_), 0x38))};
+    wash.setShader(cc::PaintShader::MakeLinearGradient(points, colors, nullptr,
+                                                       2, SkTileMode::kClamp));
+    canvas->DrawRect(bounds, wash);
+    cc::PaintFlags veil;
+    veil.setColor(SkColorSetA(SK_ColorWHITE, 0x55));
+    canvas->DrawRect(bounds, veil);
+
+    cc::PaintFlags shadow;
+    shadow.setAntiAlias(true);
+    shadow.setColor(SkColorSetA(SK_ColorBLACK, 0x2A));
+    shadow.setImageFilter(sk_make_sp<cc::BlurPaintFilter>(
+        20.f, 20.f, SkTileMode::kDecal, nullptr));
+    gfx::RectF shadow_rect(card_->bounds());
+    shadow_rect.Offset(0, 12);
+    canvas->DrawRoundRect(shadow_rect, kCardRadius, shadow);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!card_->bounds().Contains(event.location())) {
+      Close();
+    }
+    return true;
+  }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    card_->SchedulePaint();  // The automatic icon follows the name.
+  }
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    switch (event.key_code()) {
+      case ui::VKEY_RETURN:
+        Create();
+        return true;
+      case ui::VKEY_ESCAPE:
+        Close();
+        return true;
+      default:
+        return false;
+    }
+  }
+
+ private:
+  raw_ptr<BrowserView> browser_view_;
+  bool panel_;
+  base::OnceClosure close_callback_;
+  std::vector<browse_spaces::Space> spaces_;
+  raw_ptr<SheetCard> card_ = nullptr;
+  raw_ptr<views::Textfield> field_ = nullptr;
+  int icon_ = -1;  // -1: pick from the name.
+  int gradient_ = 0;
+  bool created_ = false;
+};
+
+BEGIN_METADATA(SheetView)
+END_METADATA
+
+void SheetCard::OnPaint(gfx::Canvas* canvas) {
+  const Geometry g = geo();
+  const int w = width();
+  const int slot = owner_->gradient();
+  if (panel_) {
+    // Light panel washed with the space's gradient, like Arc's.
+    canvas->DrawColor(SkColorSetRGB(0xF6, 0xF6, 0xF7));
+    const SkPoint points[2] = {SkPoint::Make(0, 0),
+                               SkPoint::Make(w * 0.6f, height())};
+    const SkColor4f colors[2] = {
+        SkColor4f::FromColor(
+            SkColorSetA(browse_spaces::ColorForIndex(slot), 0x30)),
+        SkColor4f::FromColor(
+            SkColorSetA(browse_spaces::GradientEndForIndex(slot), 0x18))};
+    cc::PaintFlags wash;
+    wash.setShader(cc::PaintShader::MakeLinearGradient(
+        points, colors, nullptr, 2, SkTileMode::kClamp));
+    canvas->DrawRect(gfx::RectF(GetLocalBounds()), wash);
+  } else {
+    canvas->DrawColor(kCardColor);
+  }
+
+  // Badge: the space's icon on its gradient, with two tilted cards behind
+  // it (a nod to Arc's card-stack illustration).
+  const gfx::RectF badge((w - kBadgeSize) / 2.f, g.badge_top, kBadgeSize,
+                         kBadgeSize);
+  for (int side : {-1, 1}) {
+    canvas->Save();
+    canvas->Translate(gfx::Vector2d(std::lround(badge.CenterPoint().x()),
+                                    std::lround(badge.CenterPoint().y())));
+    canvas->sk_canvas()->rotate(side * 14.f);
+    cc::PaintFlags back;
+    back.setAntiAlias(true);
+    back.setColor(SkColorSetA(SK_ColorWHITE, 0xF0));
+    const gfx::RectF r(side * 12 - kBadgeSize / 2.f + 2, -kBadgeSize / 2.f + 3,
+                       kBadgeSize - 4, kBadgeSize - 4);
+    cc::PaintFlags edge;
+    edge.setAntiAlias(true);
+    edge.setStyle(cc::PaintFlags::kStroke_Style);
+    edge.setStrokeWidth(1);
+    edge.setColor(SkColorSetARGB(0x1A, 0, 0, 0));
+    canvas->DrawRoundRect(r, 10, back);
+    canvas->DrawRoundRect(r, 10, edge);
+    canvas->Restore();
+  }
+  canvas->DrawRoundRect(badge, 12, GradientFlags(badge, slot, true));
+  constexpr int kBadgeIcon = 22;
+  canvas->DrawImageInt(
+      gfx::CreateVectorIcon(owner_->PreviewIcon(), kBadgeIcon, SK_ColorWHITE),
+      (w - kBadgeIcon) / 2, g.badge_top + (kBadgeSize - kBadgeIcon) / 2);
+
+  canvas->DrawStringRectWithFlags(u"Create a Space", TitleFont(), kTextColor,
+                                  gfx::Rect(0, g.title_top, w, 24),
+                                  gfx::Canvas::TEXT_ALIGN_CENTER);
+  canvas->DrawStringRectWithFlags(
+      u"Separate your tabs for life, work, projects, and more.",
+      SubtitleFont(), kSubtleText,
+      gfx::Rect(g.pad, g.subtitle_top, inner_width(), 36),
+      gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::MULTI_LINE);
+
+  // Name field, with the chosen icon on its left.
+  const gfx::Rect field_rect = FieldRect();
+  cc::PaintFlags field;
+  field.setAntiAlias(true);
+  field.setColor(panel_ ? SkColorSetA(SK_ColorWHITE, 0xE6) : kFieldFill);
+  canvas->DrawRoundRect(gfx::RectF(field_rect), 10, field);
+  constexpr int kFieldIcon = 16;
+  canvas->DrawImageInt(
+      gfx::CreateVectorIcon(owner_->PreviewIcon(), kFieldIcon,
+                            browse_spaces::ColorForIndex(slot)),
+      field_rect.x() + 13, field_rect.y() + (kFieldHeight - kFieldIcon) / 2);
+
+  canvas->DrawStringRectWithFlags(u"Icon", LabelFont(), kSubtleText,
+                                  gfx::Rect(g.pad, g.icon_label_top, w, 16),
+                                  gfx::Canvas::TEXT_ALIGN_LEFT);
+  const int selected_icon = owner_->EffectiveIcon();
+  for (int i = 0; i < browse_spaces::SpaceIconChoiceCount(); ++i) {
+    const gfx::Rect cell = IconCell(i);
+    const bool selected = i == selected_icon;
+    if (selected) {
+      cc::PaintFlags fill;
+      fill.setAntiAlias(true);
+      fill.setColor(panel_ ? SK_ColorWHITE : kSelectedFill);
+      canvas->DrawRoundRect(gfx::RectF(cell), 8, fill);
+    }
+    constexpr int kIcon = 16;
+    canvas->DrawImageInt(
+        gfx::CreateVectorIcon(browse_spaces::SpaceIconChoice(i), kIcon,
+                              selected ? kTextColor : kSubtleText),
+        cell.x() + (kIconCell - kIcon) / 2, cell.y() + (kIconCell - kIcon) / 2);
+  }
+
+  canvas->DrawStringRectWithFlags(u"Color", LabelFont(), kSubtleText,
+                                  gfx::Rect(g.pad, g.color_label_top, w, 16),
+                                  gfx::Canvas::TEXT_ALIGN_LEFT);
+  for (int i = 0; i < browse_spaces::GradientCount(); ++i) {
+    const gfx::RectF dot(ColorDot(i));
+    if (i == slot) {
+      cc::PaintFlags ring = GradientFlags(dot, i, true);
+      ring.setStyle(cc::PaintFlags::kStroke_Style);
+      ring.setStrokeWidth(2);
+      gfx::RectF outer = dot;
+      outer.Inset(-3.5f);
+      canvas->DrawRoundRect(outer, outer.width() / 2, ring);
+    }
+    canvas->DrawRoundRect(dot, dot.width() / 2, GradientFlags(dot, i, true));
+  }
+
+  // Full-width gradient button, "Cancel" under it.
+  const gfx::RectF create(CreateButton());
+  canvas->DrawRoundRect(create, 10, GradientFlags(create, slot, false));
+  canvas->DrawStringRectWithFlags(u"Create Space", ButtonFont(), SK_ColorWHITE,
+                                  CreateButton(),
+                                  gfx::Canvas::TEXT_ALIGN_CENTER);
+  canvas->DrawStringRectWithFlags(u"Cancel", ButtonFont(), kSubtleText,
+                                  CancelButton(),
+                                  gfx::Canvas::TEXT_ALIGN_CENTER);
+}
+
+bool SheetCard::OnMousePressed(const ui::MouseEvent& event) {
+  const gfx::Point p = event.location();
+  for (int i = 0; i < browse_spaces::SpaceIconChoiceCount(); ++i) {
+    if (IconCell(i).Contains(p)) {
+      owner_->set_icon(i);
+      return true;
+    }
+  }
+  for (int i = 0; i < browse_spaces::GradientCount(); ++i) {
+    gfx::Rect hit = ColorDot(i);
+    hit.Inset(-4);
+    if (hit.Contains(p)) {
+      owner_->set_gradient(i);
+      return true;
+    }
+  }
+  if (CreateButton().Contains(p)) {
+    owner_->Create();
+  } else if (CancelButton().Contains(p)) {
+    owner_->Close();
+  } else {
+    owner_->FocusField();
+  }
+  return true;
+}
+
+// Owns the sheet's widget. Only one sheet is open at a time.
+class Sheet : public views::WidgetObserver {
+ public:
+  Sheet(BrowserView* browser_view, views::View* sidebar) {
+    views::Widget* parent = browser_view->GetWidget();
+    widget_ = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.parent = parent->GetNativeView();
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    params.activatable = views::Widget::InitParams::Activatable::kYes;
+    params.name = "BrowseNewSpaceSheet";
+    params.bounds = sidebar ? sidebar->GetBoundsInScreen()
+                            : browser_view->contents_container()
+                                  ->GetBoundsInScreen();
+    widget_->Init(std::move(params));
+    view_ = widget_->SetContentsView(std::make_unique<SheetView>(
+        browser_view, /*panel=*/sidebar != nullptr,
+        base::BindOnce(&Sheet::RequestClose, base::Unretained(this))));
+    widget_observation_.Observe(widget_.get());
+    parent_observation_.Observe(parent);
+    widget_->Show();
+    view_->AnimateIn();
+    view_->FocusField();
+  }
+  ~Sheet() override = default;
+
+  void RequestClose();
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (widget == widget_.get() && !active) {
+      RequestClose();
+    }
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget_observation_.Reset();
+    parent_observation_.Reset();
+    if (widget != widget_.get()) {
+      RequestClose();
+    }
+  }
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override {
+    if (widget != widget_.get()) {
+      RequestClose();
+    }
+  }
+
+ private:
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<SheetView> view_ = nullptr;
+  bool closing_ = false;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      parent_observation_{this};
+};
+
+std::unique_ptr<Sheet>& Current() {
+  static base::NoDestructor<std::unique_ptr<Sheet>> current;
+  return *current;
+}
+
+void Sheet::RequestClose() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  widget_observation_.Reset();
+  parent_observation_.Reset();
+  if (widget_) {
+    widget_->Hide();
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce([]() { Current().reset(); }));
+}
+
+}  // namespace
+
+void Show(BrowserView* browser_view, views::View* sidebar) {
+  if (!browser_view || !browser_view->GetWidget() ||
+      !browser_view->contents_container() ||
+      browser_view->GetWidget()->IsFullscreen()) {
+    return;
+  }
+  if (Current()) {
+    Current().reset();
+  }
+  if (sidebar && (!sidebar->GetWidget() || !sidebar->GetVisible() ||
+                  sidebar->width() < 180)) {
+    sidebar = nullptr;  // Collapsed sidebar: use the floating card.
+  }
+  Current() = std::make_unique<Sheet>(browser_view, sidebar);
+}
