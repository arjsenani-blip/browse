+  GetViewAccessibility().SetName(u" ");
+}
+
+void RowView::SetEntry(const Entry& entry, bool selected, SkColor accent) {
+  entry_ = entry;
+  selected_ = selected;
+  accent_ = accent;
+  GetViewAccessibility().SetName(entry.title.empty() ? std::u16string(u" ")
+                                                     : entry.title);
+  SchedulePaint();
+}
+
+void RowView::OnMouseEntered(const ui::MouseEvent& event) {
+  owner_->Select(index_);
+}
+
+void RowView::PaintButtonContents(gfx::Canvas* canvas) {
+  const gfx::Rect bounds = GetLocalBounds();
+  if (selected_) {
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(SkColorSetA(accent_, 0x2E));
+    canvas->DrawRoundRect(gfx::RectF(bounds), kRowRadius, fill);
+  }
+
+  const int pad = 12;
+  int x = pad;
+  const int cy = bounds.height() / 2;
+  if (!entry_.icon.IsEmpty()) {
+    gfx::ImageSkia icon = entry_.icon.Rasterize(GetColorProvider());
+    if (icon.width() != kIconSize) {
+      icon = gfx::ImageSkiaOperations::CreateResizedImage(
+          icon, skia::ImageOperations::RESIZE_BEST,
+          gfx::Size(kIconSize, kIconSize));
+    }
+    canvas->DrawImageInt(icon, x, cy - kIconSize / 2);
+  }
+  x += kIconSize + 12;
+
+  const gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(1);
+  const gfx::FontList small = gfx::FontList();
+
+  // Right side: action text + arrow.
+  int right = bounds.width() - pad;
+  if (!entry_.action.empty()) {
+    const gfx::ImageSkia arrow = gfx::CreateVectorIcon(
+        vector_icons::kArrowForwardIcon, 14,
+        selected_ ? kTextColor : kSubtleText);
+    right -= arrow.width();
+    canvas->DrawImageInt(arrow, right, cy - arrow.height() / 2);
+    right -= 8;
+    const int w = gfx::GetStringWidth(entry_.action, small);
+    canvas->DrawStringRect(entry_.action, small,
+                           selected_ ? kTextColor : kSubtleText,
+                           gfx::Rect(right - w, 0, w, bounds.height()));
+    right -= w + 16;
+  }
+
+  const std::u16string title = gfx::ElideText(
+      entry_.title, font, std::max(0, right - x), gfx::ELIDE_TAIL);
+  canvas->DrawStringRect(title, font, kTextColor,
+                         gfx::Rect(x, 0, std::max(0, right - x),
+                                   bounds.height()));
+}
