+// Browse: Cmd+T opens a floating command bar over the page instead of a new
+// tab page. Typing searches or opens a URL in a new tab; open tabs show as
+// "Switch to Tab". Esc or clicking outside closes it.
+namespace browse_command_bar {
+
+// Shows the command bar for `browser`. Returns false if the bar can't be
+// shown for this window (e.g. app/popup windows), in which case the caller
+// should fall back to opening a normal new tab.
+bool Show(BrowserWindowInterface* browser);
