+CommandBarView::CommandBarView(BrowserWindowInterface* browser,
+                               base::OnceClosure close_callback)
+    : browser_(browser),
+      profile_(browser->GetProfile()),
+      close_callback_(std::move(close_callback)) {
+  const std::vector<browse_spaces::Space> spaces = browse_spaces::GetSpaces();
+  const int index = std::max(
+      0, browse_spaces::IndexOfProfile(spaces, profile_->GetOriginalProfile()));
+  accent_ = browse_spaces::ColorForIndex(index);
+  accent_end_ = browse_spaces::GradientEndForIndex(index);
+
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+
+  card_ = AddChildView(std::make_unique<views::View>());
+  card_->SetPaintToLayer();
+  card_->layer()->SetFillsBoundsOpaquely(false);
+  card_->layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(kCardRadius));
+  card_->SetBackground(views::CreateSolidBackground(kCardColor));
+
+  field_ = card_->AddChildView(std::make_unique<views::Textfield>());
+  field_->set_controller(this);
+  field_->SetBorder(nullptr);
+  field_->SetBackground(nullptr);
+  field_->SetColor(kTextColor);
+  field_->SetFontList(gfx::FontList().DeriveWithSizeDelta(5));
+  field_->SetPlaceholderText(u"Search or Enter URL…");
+  field_->GetViewAccessibility().SetName(u"Search or enter URL");
+
+  for (int i = 0; i < kMaxRows; ++i) {
+    RowView* row = card_->AddChildView(std::make_unique<RowView>(this, i));
+    row->SetVisible(false);
+    rows_.push_back(row);
+  }
+
+  AutocompleteControllerConfig config{
+      .provider_types = AutocompleteClassifier::DefaultOmniboxProviders()};
+  controller_ = std::make_unique<AutocompleteController>(
+      std::make_unique<ChromeAutocompleteProviderClient>(profile_), config);
+  controller_->AddObserver(this);
+
+  ShowOpenTabs();
+}
+
+CommandBarView::~CommandBarView() {
+  if (controller_) {
+    controller_->RemoveObserver(this);
+    controller_->Stop(AutocompleteStopReason::kClobbered);
+  }
+}
+
+gfx::Rect CommandBarView::CardBounds() const {
+  const int width = std::min(kCardMaxWidth, this->width() - 2 * kCardSideMargin);
+  int visible_rows = 0;
+  for (const auto& row : rows_) {
+    visible_rows += row->GetVisible() ? 1 : 0;
+  }
+  const int height = kFieldHeight +
+                     (visible_rows ? 1 + kRowInset * 2 +
+                                         visible_rows * kRowHeight
+                                   : 0);
+  const int x = (this->width() - width) / 2;
+  const int y = static_cast<int>(this->height() * kCardTopFraction);
+  return gfx::Rect(x, y, std::max(width, 0), height);
+}
+
+void CommandBarView::Layout(PassKey) {
+  const gfx::Rect card = CardBounds();
+  card_->SetBoundsRect(card);
+  const int field_left = 16 + 18 + 12;  // Padding + search icon + gap.
+  field_->SetBounds(field_left, 0, card.width() - field_left - 16,
+                    kFieldHeight);
+  int y = kFieldHeight + 1 + kRowInset;
+  for (const auto& row : rows_) {
+    if (!row->GetVisible()) {
+      continue;
+    }
+    row->SetBounds(kRowInset, y, card.width() - 2 * kRowInset, kRowHeight);
+    y += kRowHeight;
+  }
+  SchedulePaint();
+}
+
+void CommandBarView::OnPaint(gfx::Canvas* canvas) {
+  const gfx::RectF bounds(GetLocalBounds());
+
+  // Soft space-colored wash over the page.
+  cc::PaintFlags wash;
+  const SkPoint points[2] = {SkPoint::Make(0, 0),
+                             SkPoint::Make(bounds.width(), bounds.height())};
+  const SkColor4f colors[2] = {
+      SkColor4f::FromColor(SkColorSetA(accent_, 0x40)),
+      SkColor4f::FromColor(SkColorSetA(accent_end_, 0x30))};
+  wash.setShader(cc::PaintShader::MakeLinearGradient(points, colors, nullptr,
+                                                     2, SkTileMode::kClamp));
+  canvas->DrawRect(bounds, wash);
+  cc::PaintFlags veil;
+  veil.setColor(SkColorSetA(SK_ColorWHITE, 0x55));
+  canvas->DrawRect(bounds, veil);
+
+  // Soft shadow under the card.
+  const gfx::RectF card(CardBounds());
+  cc::PaintFlags shadow;
+  shadow.setAntiAlias(true);
+  shadow.setColor(SkColorSetA(SK_ColorBLACK, 0x26));
+  shadow.setImageFilter(sk_make_sp<cc::BlurPaintFilter>(
+      18.f, 18.f, SkTileMode::kDecal, nullptr));
+  gfx::RectF shadow_rect = card;
+  shadow_rect.Offset(0, 10);
+  canvas->DrawRoundRect(shadow_rect, kCardRadius, shadow);
+}
+
+bool CommandBarView::OnMousePressed(const ui::MouseEvent& event) {
+  if (!card_->bounds().Contains(event.location())) {
+    Close();
+    return true;
+  }
+  return false;
+}
+
+void CommandBarView::AnimateIn() {
+  layer()->SetOpacity(0.f);
+  gfx::Transform start;
+  const gfx::Rect card = CardBounds();
+  start.Translate(card.width() * 0.015f, 6.f);
+  start.Scale(0.97f, 0.97f);
+  card_->layer()->SetTransform(start);
+  {
+    ui::ScopedLayerAnimationSettings settings(layer()->GetAnimator());
+    settings.SetTransitionDuration(kAppearDuration);
+    settings.SetTweenType(gfx::Tween::EASE_OUT);
+    layer()->SetOpacity(1.f);
+  }
+  ui::ScopedLayerAnimationSettings settings(card_->layer()->GetAnimator());
+  settings.SetTransitionDuration(base::Milliseconds(200));
+  settings.SetTweenType(gfx::Tween::EASE_OUT_3);
+  card_->layer()->SetTransform(gfx::Transform());
+}
+
+void CommandBarView::ShowOpenTabs() {
+  std::vector<Entry> entries;
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (model) {
+    const int active = model->active_index();
+    for (int i = model->count() - 1; i >= 0 && entries.size() < kMaxRows;
+         --i) {
+      if (i == active) {
+        continue;
+      }
+      content::WebContents* contents = model->GetWebContentsAt(i);
+      Entry entry;
+      entry.title = contents->GetTitle();
+      entry.url = contents->GetLastCommittedURL();
+      entry.action = u"Switch to Tab";
+      entry.tab_index = i;
+      if (auto* driver =
+              favicon::ContentFaviconDriver::FromWebContents(contents)) {
+        const gfx::Image favicon = driver->GetFavicon();
+        if (!favicon.IsEmpty()) {
+          entry.icon = ui::ImageModel::FromImage(favicon);
+        }
+      }
+      if (entry.icon.IsEmpty()) {
+        entry.icon = ui::ImageModel::FromVectorIcon(vector_icons::kGlobeIcon,
+                                                    kSubtleText, kIconSize);
+      }
+      entries.push_back(std::move(entry));
+    }
+  }
+  SetEntries(std::move(entries));
+}
+
+void CommandBarView::SetEntries(std::vector<Entry> entries) {
+  entries_ = std::move(entries);
+  selected_ = 0;
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    rows_[i]->SetVisible(i < entries_.size());
+  }
+  RefreshRows();
+  InvalidateLayout();
+}
+
+void CommandBarView::RefreshRows() {
+  for (size_t i = 0; i < rows_.size() && i < entries_.size(); ++i) {
+    rows_[i]->SetEntry(entries_[i], static_cast<int>(i) == selected_, accent_);
+  }
+}
+
+void CommandBarView::Select(int index) {
+  if (index < 0 || index >= static_cast<int>(entries_.size()) ||
+      index == selected_) {
+    return;
+  }
+  selected_ = index;
+  RefreshRows();
+}
+
+void CommandBarView::ContentsChanged(views::Textfield* sender,
+                                     const std::u16string& new_contents) {
+  if (new_contents.empty()) {
+    controller_->Stop(AutocompleteStopReason::kClobbered);
+    ShowOpenTabs();
+    return;
+  }
+  AutocompleteInput input(new_contents,
+                          metrics::OmniboxEventProto::NTP_REALBOX,
+                          ChromeAutocompleteSchemeClassifier(profile_));
+  input.set_prevent_inline_autocomplete(true);
+  controller_->Start(input);
+}
+
+void CommandBarView::OnResultChanged(AutocompleteController* controller,
+                                     bool default_match_changed) {
+  if (field_->GetText().empty()) {
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  std::vector<Entry> entries;
+  for (const AutocompleteMatch& match : controller->result()) {
+    if (entries.size() >= kMaxRows) {
+      break;
+    }
+    if (!match.destination_url.is_valid()) {
+      continue;
+    }
+    Entry entry;
+    entry.url = match.destination_url;
+    entry.transition = match.transition;
+    const bool is_search = AutocompleteMatch::IsSearchType(match.type);
+    if (is_search) {
+      entry.title = match.contents;
+      entry.action = u"Search";
+    } else {
+      entry.title = match.description.empty() ? match.contents
+                                              : match.description;
+      entry.action = u"Open";
+    }
+    if (match.has_tab_match.value_or(false) && model) {
+      for (int i = 0; i < model->count(); ++i) {
+        if (model->GetWebContentsAt(i)->GetLastCommittedURL() ==
+            match.destination_url) {
+          entry.tab_index = i;
+          entry.switch_to_tab = true;
+          entry.action = u"Switch to Tab";
+          if (auto* driver = favicon::ContentFaviconDriver::FromWebContents(
+                  model->GetWebContentsAt(i))) {
+            const gfx::Image favicon = driver->GetFavicon();
+            if (!favicon.IsEmpty()) {
+              entry.icon = ui::ImageModel::FromImage(favicon);
+            }
+          }
+          break;
+        }
+      }
+    }
+    if (entry.icon.IsEmpty()) {
+      entry.icon = ui::ImageModel::FromVectorIcon(
+          match.GetVectorIcon(/*is_bookmark=*/false), kSubtleText, kIconSize);
+    }
+    entries.push_back(std::move(entry));
+  }
+  SetEntries(std::move(entries));
+  for (size_t i = 0; i < entries_.size(); ++i) {
+    if (entries_[i].tab_index < 0 &&
+        entries_[i].action != u"Search") {
+      LoadFavicon(i);
+    }
+  }
+}
+
+void CommandBarView::LoadFavicon(size_t entry_index) {
+  favicon::FaviconService* service = FaviconServiceFactory::GetForProfile(
+      profile_, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!service) {
+    return;
+  }
+  const GURL url = entries_[entry_index].url;
+  service->GetFaviconImageForPageURL(
+      url,
+      base::BindOnce(&CommandBarView::OnFavicon, weak_factory_.GetWeakPtr(),
+                     url),
+      &favicon_tracker_);
+}
+
+void CommandBarView::OnFavicon(GURL url,
+                               const favicon_base::FaviconImageResult& result) {
+  if (result.image.IsEmpty()) {
+    return;
+  }
+  for (Entry& entry : entries_) {
+    if (entry.url == url && entry.tab_index < 0) {
+      entry.icon = ui::ImageModel::FromImage(result.image);
+    }
+  }
+  RefreshRows();
+}
+
+bool CommandBarView::HandleKeyEvent(views::Textfield* sender,
+                                    const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  switch (key_event.key_code()) {
+    case ui::VKEY_ESCAPE:
+      Close();
+      return true;
+    case ui::VKEY_DOWN:
+      Select(std::min(selected_ + 1, static_cast<int>(entries_.size()) - 1));
+      return true;
+    case ui::VKEY_UP:
+      Select(std::max(selected_ - 1, 0));
+      return true;
+    case ui::VKEY_RETURN:
+      if (!entries_.empty()) {
+        Activate(selected_);
+      } else {
+        OpenTypedText();
+      }
+      return true;
+    default:
+      return false;
+  }
+}
+
+void CommandBarView::OpenTypedText() {
+  const std::u16string text(field_->GetText());
+  if (text.empty()) {
+    Close();
+    return;
+  }
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(profile_)->Classify(
+      text, false, false, metrics::OmniboxEventProto::NTP_REALBOX, &match,
+      nullptr);
+  if (match.destination_url.is_valid()) {
+    NavigateParams params(browser_, match.destination_url, match.transition);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+  }
+  Close();
+}
+
+void CommandBarView::Activate(int index) {
+  if (index < 0 || index >= static_cast<int>(entries_.size())) {
+    return;
+  }
+  const Entry entry = entries_[index];
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (entry.tab_index >= 0 && model && entry.tab_index < model->count()) {
+    model->ActivateTabAt(entry.tab_index);
+  } else if (entry.url.is_valid()) {
+    NavigateParams params(browser_, entry.url, entry.transition);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+  }
+  Close();
+}
+
+void CommandBarView::Close() {
+  if (close_callback_) {
+    std::move(close_callback_).Run();
+  }
+}
+
+BEGIN_METADATA(CommandBarView)
+END_METADATA
+
+// Owns the bar's widget. Only one bar is open at a time.
+class CommandBar : public views::WidgetObserver {
+ public:
+  explicit CommandBar(BrowserView* browser_view)
+      : browser_view_(browser_view) {
+    views::Widget* parent = browser_view->GetWidget();
+    widget_ = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.parent = parent->GetNativeView();
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    params.activatable = views::Widget::InitParams::Activatable::kYes;
+    params.name = "BrowseCommandBar";
+    params.bounds = browser_view->contents_container()->GetBoundsInScreen();
+    widget_->Init(std::move(params));
+
+    view_ = widget_->SetContentsView(std::make_unique<CommandBarView>(
+        browser_view->browser(),
+        base::BindOnce(&CommandBar::RequestClose, base::Unretained(this))));
+
+    widget_observation_.Observe(widget_.get());
+    parent_observation_.Observe(parent);
+    widget_->Show();
+    view_->AnimateIn();
+    view_->FocusField();
+  }
+
+  ~CommandBar() override = default;
+
+  BrowserView* browser_view() const { return browser_view_; }
+
+  void RequestClose();
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (widget == widget_.get() && !active) {
+      RequestClose();
+    }
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget_observation_.Reset();
+    parent_observation_.Reset();
+    if (widget != widget_.get()) {
+      // The browser window is going away: close with it.
+      RequestClose();
+    }
+  }
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override {
+    if (widget != widget_.get()) {
+      RequestClose();  // Window moved or resized: just dismiss.
+    }
+  }
+
+ private:
+  raw_ptr<BrowserView> browser_view_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<CommandBarView> view_ = nullptr;
+  bool closing_ = false;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      parent_observation_{this};
+
+};
+
+std::unique_ptr<CommandBar>& Current() {
+  static base::NoDestructor<std::unique_ptr<CommandBar>> current;
+  return *current;
+}
+
+void CommandBar::RequestClose() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  widget_observation_.Reset();
+  parent_observation_.Reset();
+  if (widget_) {
+    widget_->Hide();
+  }
+  // Destroy outside of any event or observer callback that got us here.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce([]() { Current().reset(); }));
+}
+
+}  // namespace
+
+bool Show(BrowserWindowInterface* browser) {
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return false;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->GetWidget() ||
+      !browser_view->contents_container() ||
+      browser_view->GetWidget()->IsFullscreen()) {
+    return false;
+  }
+  if (Current()) {
+    // A pending close of a previous bar; drop it now.
+    Current().reset();
+  }
+  Current() = std::make_unique<CommandBar>(browser_view);
+  return true;
+}
