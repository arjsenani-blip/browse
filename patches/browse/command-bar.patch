+constexpr int kCardMaxWidth = 620;
+constexpr int kCardSideMargin = 40;
+constexpr int kCardRadius = 14;
+constexpr int kFieldHeight = 54;
+constexpr int kRowHeight = 40;
+constexpr int kRowInset = 8;
+constexpr int kRowRadius = 9;
+constexpr int kIconSize = 16;
+constexpr int kMaxRows = 6;
+constexpr float kCardTopFraction = 0.24f;
+constexpr base::TimeDelta kAppearDuration = base::Milliseconds(150);
+
+const SkColor kCardColor = SK_ColorWHITE;
+const SkColor kTextColor = SkColorSetRGB(0x18, 0x18, 0x1B);
+const SkColor kSubtleText = SkColorSetRGB(0x71, 0x71, 0x7A);
+const SkColor kHairline = SkColorSetARGB(0x14, 0, 0, 0);
+
+// One suggestion row.
+struct Entry {
+  std::u16string title;
+  std::u16string action;  // "Switch to Tab", "Open", "Search".
+  ui::ImageModel icon;
+  GURL url;
+  ui::PageTransition transition = ui::PAGE_TRANSITION_TYPED;
+  int tab_index = -1;      // >= 0: activate this tab in the browser.
+  bool switch_to_tab = false;
+};
+
+class CommandBarView;
+
+// Clickable result row; paints itself so selection and hover stay cheap.
+class RowView : public views::Button {
+  METADATA_HEADER(RowView, views::Button)
+
+ public:
+  RowView(CommandBarView* owner, int index);
+  void SetEntry(const Entry& entry, bool selected, SkColor accent);
+  void PaintButtonContents(gfx::Canvas* canvas) override;
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+
+ private:
+  raw_ptr<CommandBarView> owner_;
+  int index_;
+  Entry entry_;
+  bool selected_ = false;
+  SkColor accent_ = SK_ColorCYAN;
+};
+
+class CommandBarView : public views::View,
+                       public views::TextfieldController,
+                       public AutocompleteController::Observer {
+  METADATA_HEADER(CommandBarView, views::View)
+
+ public:
+  CommandBarView(BrowserWindowInterface* browser,
+                 base::OnceClosure close_callback);
+  ~CommandBarView() override;
+
+  void FocusField() { field_->RequestFocus(); }
+  void AnimateIn();
+  void Select(int index);
+  void Activate(int index);
+  void Close();
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override;
+
+ private:
+  gfx::Rect CardBounds() const;
+  void ShowOpenTabs();
+  void SetEntries(std::vector<Entry> entries);
+  void RefreshRows();
+  void LoadFavicon(size_t entry_index);
+  void OnFavicon(GURL url, const favicon_base::FaviconImageResult& result);
+  void OpenTypedText();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<Profile> profile_;
+  base::OnceClosure close_callback_;
+  SkColor accent_;
+  SkColor accent_end_;
+
+  raw_ptr<views::View> card_ = nullptr;
+  raw_ptr<views::Textfield> field_ = nullptr;
+  std::vector<raw_ptr<RowView>> rows_;
+  std::vector<Entry> entries_;
+  int selected_ = 0;
