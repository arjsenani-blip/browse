+// Copyright 2026 The Browse Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_BROWSE_LOADING_BAR_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_BROWSE_LOADING_BAR_VIEW_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/animation/animation_delegate.h"
+#include "ui/gfx/animation/slide_animation.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+
+class BrowserView;
+class ContentsWebView;
+
+// Browse: a thin neon progress line along the top of the page. It tracks the
+// front tab's real load progress, glows in the space's color and fades out
+// when loading finishes. Nothing animates or repaints while idle.
+class BrowseLoadingBarView : public views::View,
+                             public content::WebContentsObserver,
+                             public views::ViewObserver,
+                             public gfx::AnimationDelegate {
+  METADATA_HEADER(BrowseLoadingBarView, views::View)
+
+ public:
+  BrowseLoadingBarView(BrowserView* browser_view, ContentsWebView* host);
+  BrowseLoadingBarView(const BrowseLoadingBarView&) = delete;
+  BrowseLoadingBarView& operator=(const BrowseLoadingBarView&) = delete;
+  ~BrowseLoadingBarView() override;
+
+  // Called by ContentsWebView whenever its web contents changes.
+  void SetWebContents(content::WebContents* web_contents);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  bool GetCanProcessEventsWithinSubtree() const override;
+  void OnThemeChanged() override;
+
+  // content::WebContentsObserver:
+  void DidStartLoading() override;
+  void DidStopLoading() override;
+  void LoadProgressChanged(double progress) override;
+  void WebContentsDestroyed() override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  void SyncBounds();
+  void UpdateColor();
+  void Begin();
+  void AnimateTo(double target);
+  void FinishAndFade();
+  void HideNow();
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<ContentsWebView> host_;
+  base::ScopedObservation<views::View, views::ViewObserver> host_observation_{
+      this};
+
+  SkColor color_ = SK_ColorCYAN;
+  SkColor end_color_ = SK_ColorBLUE;
+  bool active_ = false;
+  bool finishing_ = false;
+  double shown_ = 0.0;
+  double from_ = 0.0;
+  double to_ = 0.0;
+  std::unique_ptr<gfx::SlideAnimation> progress_animation_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_BROWSE_LOADING_BAR_VIEW_H_
