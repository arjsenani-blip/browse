===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ src/chrome/browser/ui/views/frame/browse_loading_bar_view.cc	2026-11-05 22:09:11.808394456 -0500
@@ -0,0 +1,237 @@
+// Copyright 2026 The Browse Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/browse_loading_bar_view.h"
+
+#include <algorithm>
+
+#include "cc/paint/paint_filter.h"
+#include "cc/paint/paint_flags.h"
+#include "cc/paint/paint_shader.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browse_space_indicator_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/contents_web_view.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/scoped_layer_animation_settings.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+constexpr int kBarHeight = 10;       // Includes room for the glow.
+constexpr float kLineHeight = 2.5f;  // The crisp line itself.
+constexpr float kGlowSigma = 3.0f;
+constexpr base::TimeDelta kProgressDuration = base::Milliseconds(260);
+constexpr base::TimeDelta kFadeDuration = base::Milliseconds(320);
+constexpr double kStartProgress = 0.08;
+
+}  // namespace
+
+BrowseLoadingBarView::BrowseLoadingBarView(BrowserView* browser_view,
+                                           ContentsWebView* host)
+    : browser_view_(browser_view),
+      host_(host),
+      progress_animation_(std::make_unique<gfx::SlideAnimation>(this)) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetOpacity(0.f);
+  SetProperty(views::kViewIgnoredByLayoutKey, true);
+  GetViewAccessibility().SetIsIgnored(true);
+  SetVisible(false);
+
+  progress_animation_->SetSlideDuration(kProgressDuration);
+  progress_animation_->SetTweenType(gfx::Tween::EASE_OUT);
+
+  host_observation_.Observe(host_.get());
+  UpdateColor();
+}
+
+BrowseLoadingBarView::~BrowseLoadingBarView() {
+  if (host_) {
+    host_->set_browse_loading_bar(nullptr);
+  }
+}
+
+void BrowseLoadingBarView::SetWebContents(content::WebContents* web_contents) {
+  if (web_contents == this->web_contents()) {
+    return;
+  }
+  Observe(web_contents);
+  if (web_contents && web_contents->ShouldShowLoadingUI()) {
+    // Switched to a tab that is mid-load: pick up where it is.
+    Begin();
+    AnimateTo(std::max(kStartProgress, web_contents->GetLoadProgress()));
+  } else {
+    HideNow();
+  }
+}
+
+void BrowseLoadingBarView::OnPaint(gfx::Canvas* canvas) {
+  if (shown_ <= 0.0) {
+    return;
+  }
+  const float width = static_cast<float>(this->width()) * shown_;
+  const gfx::RectF line(0, 0, width, kLineHeight);
+
+  // Neon gradient: the space color, brightening toward the leading edge.
+  const SkColor bright =
+      color_utils::AlphaBlend(SK_ColorWHITE, end_color_, 0.35f);
+  const SkPoint points[2] = {SkPoint::Make(0, 0), SkPoint::Make(width, 0)};
+  const SkColor4f colors[3] = {SkColor4f::FromColor(color_),
+                               SkColor4f::FromColor(end_color_),
+                               SkColor4f::FromColor(bright)};
+  const SkScalar positions[3] = {0.f, 0.85f, 1.f};
+
+  // Soft glow underneath.
+  cc::PaintFlags glow;
+  glow.setAntiAlias(true);
+  glow.setShader(cc::PaintShader::MakeLinearGradient(
+      points, colors, positions, 3, SkTileMode::kClamp));
+  glow.setAlphaf(0.55f);
+  glow.setImageFilter(sk_make_sp<cc::BlurPaintFilter>(
+      kGlowSigma, kGlowSigma, SkTileMode::kDecal, nullptr));
+  canvas->DrawRect(gfx::RectF(0, 0, width, kLineHeight + 2.f), glow);
+
+  // Crisp line on top, with a rounded leading edge.
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setShader(cc::PaintShader::MakeLinearGradient(
+      points, colors, positions, 3, SkTileMode::kClamp));
+  canvas->DrawRoundRect(line, kLineHeight / 2, flags);
+}
+
+bool BrowseLoadingBarView::GetCanProcessEventsWithinSubtree() const {
+  return false;
+}
+
+void BrowseLoadingBarView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  UpdateColor();
+}
+
+void BrowseLoadingBarView::DidStartLoading() {
+  if (!web_contents() || !web_contents()->ShouldShowLoadingUI()) {
+    return;  // Ignore same-document and subframe-only loads.
+  }
+  Begin();
+  AnimateTo(kStartProgress);
+}
+
+void BrowseLoadingBarView::DidStopLoading() {
+  if (active_) {
+    FinishAndFade();
+  }
+}
+
+void BrowseLoadingBarView::LoadProgressChanged(double progress) {
+  if (!active_ || finishing_) {
+    return;
+  }
+  if (progress >= 1.0) {
+    FinishAndFade();
+    return;
+  }
+  if (progress > to_) {
+    AnimateTo(progress);
+  }
+}
+
+void BrowseLoadingBarView::WebContentsDestroyed() {
+  Observe(nullptr);
+  HideNow();
+}
+
+void BrowseLoadingBarView::OnViewBoundsChanged(views::View* observed_view) {
+  SyncBounds();
+}
+
+void BrowseLoadingBarView::OnViewIsDeleting(views::View* observed_view) {
+  host_observation_.Reset();
+  host_ = nullptr;
+}
+
+void BrowseLoadingBarView::AnimationProgressed(
+    const gfx::Animation* animation) {
+  shown_ = gfx::Tween::DoubleValueBetween(animation->GetCurrentValue(), from_,
+                                          to_);
+  SchedulePaint();
+}
+
+void BrowseLoadingBarView::AnimationEnded(const gfx::Animation* animation) {
+  shown_ = to_;
+  SchedulePaint();
+  if (finishing_) {
+    // Fade on the compositor; no repaints needed while it fades.
+    ui::ScopedLayerAnimationSettings settings(layer()->GetAnimator());
+    settings.SetTransitionDuration(kFadeDuration);
+    settings.SetTweenType(gfx::Tween::EASE_OUT);
+    layer()->SetOpacity(0.f);
+    active_ = false;
+    finishing_ = false;
+  }
+}
+
+void BrowseLoadingBarView::SyncBounds() {
+  if (!host_) {
+    return;
+  }
+  SetBounds(host_->x(), host_->y(), host_->width(), kBarHeight);
+}
+
+void BrowseLoadingBarView::UpdateColor() {
+  Profile* profile = browser_view_->browser()->GetProfile();
+  const std::vector<browse_spaces::Space> spaces = browse_spaces::GetSpaces();
+  const int index = browse_spaces::IndexOfProfile(spaces, profile);
+  color_ = browse_spaces::ColorForIndex(std::max(index, 0));
+  end_color_ = browse_spaces::GradientEndForIndex(std::max(index, 0));
+  if (shown_ > 0.0) {
+    SchedulePaint();
+  }
+}
+
+void BrowseLoadingBarView::Begin() {
+  SyncBounds();
+  layer()->GetAnimator()->StopAnimating();
+  if (!active_ || finishing_) {
+    shown_ = 0.0;
+    to_ = 0.0;
+  }
+  active_ = true;
+  finishing_ = false;
+  SetVisible(true);
+  layer()->SetOpacity(1.f);
+}
+
+void BrowseLoadingBarView::AnimateTo(double target) {
+  from_ = shown_;
+  to_ = std::clamp(target, 0.0, 1.0);
+  progress_animation_->Reset(0.0);
+  progress_animation_->Show();
+}
+
+void BrowseLoadingBarView::FinishAndFade() {
+  finishing_ = true;
+  AnimateTo(1.0);
+}
+
+void BrowseLoadingBarView::HideNow() {
+  progress_animation_->Stop();
+  layer()->GetAnimator()->StopAnimating();
+  active_ = false;
+  finishing_ = false;
+  shown_ = to_ = from_ = 0.0;
+  layer()->SetOpacity(0.f);
+  SetVisible(false);
+}
+
+BEGIN_METADATA(BrowseLoadingBarView)
+END_METADATA
