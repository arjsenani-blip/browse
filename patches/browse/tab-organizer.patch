+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_BROWSE_TAB_ORGANIZER_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_BROWSE_TAB_ORGANIZER_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "url/gurl.h"
+
+class TabStripModel;
+
+// Browse: keeps a long sidebar readable.
+//  - Three or more unpinned tabs from the same site are gathered into a
+//    collapsible grey group titled "Site · N".
+//  - Tabs not used for 12 hours move into a collapsed "Earlier" group at the
+//    bottom; using one brings it back out.
+// Only groups Browse made are touched; the user's own groups are left alone.
+// Work is debounced and runs on tab changes plus a slow 15 minute timer.
+class BrowseTabOrganizer : public TabStripModelObserver {
+ public:
+  explicit BrowseTabOrganizer(TabStripModel* model);
+  BrowseTabOrganizer(const BrowseTabOrganizer&) = delete;
+  BrowseTabOrganizer& operator=(const BrowseTabOrganizer&) = delete;
+  ~BrowseTabOrganizer() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+
+  // Site key and display name for a URL ("docs.google.com" -> "Docs").
+  static std::string SiteKeyFor(const GURL& url);
+  static std::u16string SiteNameFor(const GURL& url);
+
+ private:
+  void Schedule();
+  void Organize();
+  void AdoptExistingGroups();
+  bool IsOurs(const tab_groups::TabGroupId& group) const;
+  void UpdateSiteGroupTitle(const std::string& key,
+                            const tab_groups::TabGroupId& group);
+  void OrganizeSites();
+  void OrganizeEarlier();
+  void ReleaseActiveFromEarlier();
+
+  raw_ptr<TabStripModel> model_;
+  std::map<std::string, tab_groups::TabGroupId> site_groups_;
+  std::optional<tab_groups::TabGroupId> earlier_group_;
+  bool organizing_ = false;
+  bool adopted_ = false;
+  base::OneShotTimer debounce_;
+  base::RepeatingTimer slow_timer_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_BROWSE_TAB_ORGANIZER_H_
