+void BrowseLoadingBarView::MaybeShowCommandBar() {
+  content::WebContents* contents = web_contents();
+  if (!contents || contents->IsLoading() ||
+      contents->GetVisibleURL() != GURL(chrome::kChromeUINewTabURL)) {
+    return;
+  }
+  const uintptr_t id = reinterpret_cast<uintptr_t>(contents);
+  if (id == command_bar_shown_for_) {
+    return;
+  }
+  command_bar_shown_for_ = id;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowseLoadingBarView> self) {
+            if (self && self->GetWidget() && self->GetWidget()->IsActive()) {
+              browse_command_bar::Show(self->browser_view_->browser());
+            }
+          },
+          weak_factory_.GetWeakPtr()));
 }
 
