+
+class BrowserView;
+class Profile;
+
+namespace views {
+class MenuRunner;
+}
+
+// Browse: Dia-style "spaces". A space is a regular Chromium profile. This
+// view sits at the leading edge of the horizontal tab strip (right after the
+// traffic lights) and shows the current space's name with one dot per space.
+// A two-finger horizontal swipe anywhere on the tab strip region moves to the
+// previous/next space; clicking opens a menu of spaces.
+namespace browse_spaces {
+
+struct Space {
+  base::FilePath path;
+  std::u16string name;
+};
+
+// All user-visible profiles, in creation order (Default, Profile 1, ...).
+std::vector<Space> GetSpaces();
+
+// Index of `profile` in `spaces`, or -1.
+int IndexOfProfile(const std::vector<Space>& spaces, Profile* profile);
+
+// Default palette, picked by space index.
+SkColor ColorForIndex(int index);
+
+// Brings `path`'s window to the front in exactly `from`'s window frame,
+// opening a new window there if the profile has none.
+void SwitchToSpace(BrowserView* from, const base::FilePath& path);
+
+}  // namespace browse_spaces
+
+class BrowseSpaceIndicatorView : public views::Button,
+                                 public ui::SimpleMenuModel::Delegate,
+                                 public ProfileAttributesStorageObserver {
+  METADATA_HEADER(BrowseSpaceIndicatorView, views::Button)
+
+ public:
+  explicit BrowseSpaceIndicatorView(BrowserView* browser_view);
+  BrowseSpaceIndicatorView(const BrowseSpaceIndicatorView&) = delete;
+  BrowseSpaceIndicatorView& operator=(const BrowseSpaceIndicatorView&) =
+      delete;
+  ~BrowseSpaceIndicatorView() override;
+
+  // Whether a space indicator should be shown for this window at all
+  // (normal, non-incognito browser windows only).
+  static bool ShouldShowFor(BrowserView* browser_view);
+
+  // Width the tab strip region must reserve for this view (0 if hidden).
+  static int LeadingWidthFor(const views::View* region);
+
+  // Attaches the swipe handler to the tab strip region (our parent).
+  void AttachSwipeHandlerTo(views::View* region);
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void PaintButtonContents(gfx::Canvas* canvas) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+  bool IsCommandIdChecked(int command_id) const override;
+
+  // ProfileAttributesStorageObserver:
+  void OnProfileAdded(const base::FilePath& profile_path) override;
+  void OnProfileWasRemoved(const base::FilePath& profile_path,
+                           const std::u16string& profile_name) override;
+  void OnProfileNameChanged(const base::FilePath& profile_path,
+                            const std::u16string& old_profile_name) override;
+  void OnProfileIsOmittedChanged(const base::FilePath& profile_path) override;
+
+
+ private:
+  class SwipeHandler;
+  friend class SwipeHandler;
+  class SettleDelegate;
+
+  void OnSettleProgressed(const gfx::Animation* animation);
+  void OnSettleEnded();
+
+  void RefreshSpaces();
+  void OnPressed();
+  void SwitchBy(int delta);
+
+  // Swipe state. `swipe_offset_` is in DIPs; positive means the content has
+  // moved towards the trailing side (i.e. the previous space is sliding in).
+  void OnSwipeBegin();
+  void OnSwipeUpdate(float dx);
+  void OnSwipeEnd();
+  float swipe_progress() const;
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<views::View> region_ = nullptr;
+  std::unique_ptr<SwipeHandler> swipe_handler_;
+
+  std::vector<browse_spaces::Space> spaces_;
+  int current_index_ = -1;
+
+  float swipe_offset_ = 0;
+  float last_dx_ = 0;
+  base::TimeTicks last_dx_time_;
+  float flick_velocity_ = 0;  // DIPs per second, signed.
+
+  // Animates `swipe_offset_` from `anim_from_` to `anim_to_`.
+  std::unique_ptr<SettleDelegate> settle_delegate_;
+  std::unique_ptr<gfx::SlideAnimation> settle_animation_;
+  float anim_from_ = 0;
+  float anim_to_ = 0;
+  int pending_switch_delta_ = 0;
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  base::ScopedObservation<ProfileAttributesStorage,
+                          ProfileAttributesStorageObserver>
+      storage_observation_{this};
+};
