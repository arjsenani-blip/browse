+namespace {
+// Browse: thin neon gradient bar on the left edge of the active tab.
+void PaintBrowseAccent(const TabStyleViewDelegate* delegate,
+                       gfx::Canvas* canvas) {
+  BrowserWindowInterface* browser = delegate->GetBrowserWindowInterface();
+  if (!browser) {
+    return;
+  }
+  const std::vector<browse_spaces::Space> spaces = browse_spaces::GetSpaces();
+  const int index = std::max(
+      0, browse_spaces::IndexOfProfile(spaces, browser->GetProfile()));
+  const gfx::Rect bounds = delegate->GetView()->GetLocalBounds();
+  const float top = bounds.y() + 8.f;
+  const float bottom = bounds.bottom() - 8.f;
+  if (bottom <= top) {
+    return;
+  }
+  const SkPoint points[2] = {SkPoint::Make(0, top), SkPoint::Make(0, bottom)};
+  const SkColor4f colors[2] = {
+      SkColor4f::FromColor(browse_spaces::ColorForIndex(index)),
+      SkColor4f::FromColor(browse_spaces::GradientEndForIndex(index))};
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setShader(cc::PaintShader::MakeLinearGradient(points, colors, nullptr,
+                                                      2, SkTileMode::kClamp));
+  canvas->DrawRoundRect(gfx::RectF(bounds.x() + 3.f, top, 2.f, bottom - top),
+                        1.f, flags);
+}
+}  // namespace
