+int BrowseSpaceIndicatorView::SidebarIconIndexAt(int x) const {
+  const int i = (x - kSidebarLeft) / (kSidebarCell + kSidebarGap);
+  if (x < kSidebarLeft || i < 0 || i >= static_cast<int>(spaces_.size())) {
+    return -1;
+  }
+  return i;
+}
+
+void BrowseSpaceIndicatorView::PaintSidebar(gfx::Canvas* canvas) {
+  const ui::ColorProvider* cp = GetColorProvider();
+  const SkColor strong = cp->GetColor(ui::kColorSysOnSurface);
+  const SkColor subtle = cp->GetColor(ui::kColorSysOnSurfaceSubtle);
+  const bool dark = color_utils::IsDark(cp->GetColor(ui::kColorSysSurface));
+  const gfx::Rect bounds = GetLocalBounds();
+  const int count = static_cast<int>(spaces_.size());
+  const int cy = bounds.height() / 2;
+
+  // The highlight glides from the current icon towards the target.
+  const float progress = std::clamp(swipe_progress(), -1.f, 1.f);
+  const int target = progress < 0 ? current_index_ + 1 : current_index_ - 1;
+  const float t = (target >= 0 && target < count) ? std::abs(progress) : 0.f;
+  const float from_x = kSidebarLeft + current_index_ * (kSidebarCell + kSidebarGap);
+  const float to_x = kSidebarLeft + std::clamp(target, 0, count - 1) *
+                                        (kSidebarCell + kSidebarGap);
+  const float hx = from_x + (to_x - from_x) * t;
+  const gfx::RectF cell(hx, cy - kSidebarCell / 2.f, kSidebarCell, kSidebarCell);
+  cc::PaintFlags fill;
+  fill.setAntiAlias(true);
+  fill.setColor(dark ? SkColorSetA(SK_ColorWHITE, 0x1F)
+                     : SkColorSetA(SK_ColorWHITE, 0xE6));
+  canvas->DrawRoundRect(cell, 8, fill);
+
+  // Neon gradient underline under the highlighted icon.
+  const int accent_index =
+      t > 0.5f ? std::clamp(target, 0, count - 1) : current_index_;
+  const SkPoint points[2] = {SkPoint::Make(cell.x() + 9, 0),
+                             SkPoint::Make(cell.right() - 9, 0)};
+  const SkColor4f colors[2] = {
+      SkColor4f::FromColor(browse_spaces::ColorForIndex(accent_index)),
+      SkColor4f::FromColor(browse_spaces::GradientEndForIndex(accent_index))};
+  cc::PaintFlags line;
+  line.setAntiAlias(true);
+  line.setShader(cc::PaintShader::MakeLinearGradient(points, colors, nullptr, 2,
+                                                     SkTileMode::kClamp));
+  canvas->DrawRoundRect(
+      gfx::RectF(cell.x() + 9, cell.bottom() - 5, kSidebarCell - 18, 2), 1,
+      line);
+
+  for (int i = 0; i < count; ++i) {
+    float emphasis = 0.f;
+    if (i == current_index_) {
+      emphasis = 1.f - t;
+    } else if (i == target) {
+      emphasis = t;
+    }
+    const SkColor color = color_utils::AlphaBlend(strong, subtle, emphasis);
+    const gfx::ImageSkia icon = gfx::CreateVectorIcon(
+        browse_spaces::IconForSpace(spaces_[i], i), kSidebarIcon,
+        SkColorSetA(color, static_cast<U8CPU>(255 * (0.55f + 0.45f * emphasis))));
+    const int x = kSidebarLeft + i * (kSidebarCell + kSidebarGap) +
+                  (kSidebarCell - kSidebarIcon) / 2;
+    canvas->DrawImageInt(icon, x, cy - kSidebarIcon / 2);
+  }
+
+  // Name on the right; follows the fingers like the tab strip label.
+  const int name_left = kSidebarLeft + count * (kSidebarCell + kSidebarGap) + 8;
+  const gfx::Rect name_area(name_left, 0, std::max(0, bounds.width() - name_left - 6),
+                            bounds.height());
+  if (name_area.width() <= 0) {
+    return;
+  }
+  canvas->Save();
+  canvas->ClipRect(name_area);
+  const int shift = std::lround(progress * name_area.width());
+  auto draw_name = [&](int index, int x_offset) {
+    if (index < 0 || index >= count) {
+      return;
+    }
+    gfx::Rect r = name_area;
+    r.Offset(x_offset, 0);
+    const float fade = 1.f - std::min(1.f, std::abs(x_offset) /
+                                               static_cast<float>(r.width()));
+    canvas->DrawStringRectWithFlags(
+        spaces_[index].name, NameFont(),
+        SkColorSetA(subtle, static_cast<U8CPU>(SkColorGetA(subtle) * fade)), r,
+        gfx::Canvas::TEXT_ALIGN_RIGHT | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+  };
+  draw_name(current_index_, shift);
+  if (shift < 0) {
+    draw_name(current_index_ + 1, shift + name_area.width());
+  } else if (shift > 0) {
+    draw_name(current_index_ - 1, shift - name_area.width());
+  }
+  canvas->Restore();
+}
