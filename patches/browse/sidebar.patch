+const gfx::VectorIcon& IconForSpace(const Space& space, int index) {
+  const std::u16string name = base::ToLowerASCII(space.name);
+  auto has = [&](const char16_t* word) {
+    return name.find(word) != std::u16string::npos;
+  };
+  if (has(u"school") || has(u"class") || has(u"study")) {
+    return kMenuBookIcon;
+  }
+  if (has(u"debate") || has(u"speech")) {
+    return vector_icons::kMicIcon;
+  }
+  if (has(u"dev") || has(u"code") || has(u"web")) {
+    return kCodeIcon;
+  }
+  if (has(u"h4h") || has(u"home") || has(u"habitat") || has(u"house")) {
+    return kHomeIcon;
+  }
+  if (has(u"amma") || has(u"mom") || has(u"family") || has(u"mum")) {
+    return vector_icons::kFamilyLinkIcon;
+  }
+  if (has(u"work") || has(u"job")) {
+    return vector_icons::kWorkIcon;
+  }
+  if (has(u"personal") || has(u"me") || index == 0) {
+    return kPersonFilledIcon;
+  }
+  static constexpr const gfx::VectorIcon* kFallback[] = {
+      &kGlobeIcon, &vector_icons::kLightbulbIcon, &kRocketLaunchIcon};
+  return *kFallback[static_cast<size_t>(std::max(index, 0)) %
+                    std::size(kFallback)];
+}
