<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WebKit JIT in the web content process is handled by WebKit itself; the
	     app needs only these. The passkey entitlement
	     (com.apple.developer.web-browser.public-key-credential) is added once
	     Apple grants it, together with a Developer ID provisioning profile. -->
	<key>com.apple.security.device.camera</key><true/>
	<key>com.apple.security.device.audio-input</key><true/>
	<key>com.apple.security.personal-information.location</key><true/>
</dict>
</plist>
